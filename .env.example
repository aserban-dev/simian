# Copy to .env and fill in. The API refuses to start when a required variable is unset,
# rather than failing later at first use.
#
# Nothing in this file is a payment credential, and nothing ever will be — the app has no
# payment integration by design (constitution, Principle I).

# --- Database ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dupermarket
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dupermarket

# --- Firebase (identity + push) ---------------------------------------------------------
# FIREBASE_PROJECT_ID must match the client's project or every authenticated call 401s.
FIREBASE_PROJECT_ID=
FIREBASE_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwks
# Server key for sending pushes. Not needed for delivery-stage notifications, which are
# scheduled on-device (research D6) — only for promotional sends.
FCM_SERVER_KEY=

# --- Cloudflare R2 (image CDN) ----------------------------------------------------------
# S3-compatible. The backend writes here during seeding and never proxies image bytes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dupermarket-products
R2_PUBLIC_BASE_URL=https://images.dupermarket.example

# --- Google Maps ------------------------------------------------------------------------
# Geocoding is metered. Addresses are geocoded once on write and never on read (FR-042).
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# --- Seed pipeline (operator tool, not the API) -----------------------------------------
PEXELS_API_KEY=
SEED_IMAGE_CACHE_DIR=seed/.cache
SEED_RATE_LIMIT_PER_HOUR=180

# --- App behaviour ----------------------------------------------------------------------
BASE_CURRENCY=EUR
CATALOGUE_CACHE_TTL_SECONDS=3600
ENVIRONMENT=dev
LOG_LEVEL=INFO
